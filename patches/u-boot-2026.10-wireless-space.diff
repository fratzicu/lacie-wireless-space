diff --git a/board/LaCie/wireless_space/wireless_space.env b/board/LaCie/wireless_space/wireless_space.env
new file mode 100644
index 0000000000..1e8c503585
--- /dev/null
+++ b/board/LaCie/wireless_space/wireless_space.env
@@ -0,0 +1,77 @@
+/* LaCie Wireless Space default environment */
+
+/*
+ * Network defaults: the box is 192.168.1.1, the PC with the TFTP/HTTP server
+ * is 192.168.1.2 (change with setenv/saveenv)
+ */
+ipaddr=192.168.1.1
+serverip=192.168.1.2
+netmask=255.255.255.0
+
+/* Images looked for on TFTP/HTTP/USB */
+initramfs_file=openwrt-kirkwood-generic-lacie_wireless-space-initramfs-uImage
+factory_file=openwrt-kirkwood-generic-lacie_wireless-space-squashfs-factory.bin
+http_url=http://192.168.1.2/openwrt-kirkwood-generic-lacie_wireless-space-initramfs-uImage
+
+/*
+ * Boot counting (CONFIG_BOOTCOUNT_ENV): only active while upgrade_available=1,
+ * which flashing sets. OpenWrt clears it after a successful boot. After
+ * bootlimit failed boots altbootcmd starts the web recovery instead.
+ */
+bootlimit=3
+upgrade_available=0
+altbootcmd=echo "*** ${bootcount} failed boots, starting web recovery ***"; run recovery
+
+/* Boot sources */
+boot_nand=ubi part ubi && ubi read ${loadaddr} kernel && bootm ${loadaddr}
+boot_usb=run usbload && bootm ${loadaddr}
+boot_disk=run diskload && bootm ${loadaddr}
+boot_tftp=tftpboot ${loadaddr} ${initramfs_file} && bootm ${loadaddr}
+boot_http=wget ${loadaddr} ${http_url} && bootm ${loadaddr}
+boot_pxe=dhcp && pxe get && pxe boot
+boot_default=run boot_nand; echo "NAND boot failed, trying USB/disk"; run boot_usb; run boot_disk; echo "*** no bootable system, starting web recovery ***"; run recovery
+
+/*
+ * Recovery and flashing: every source ends in recovery_apply, which acts on
+ * $img_type as set by "httpd" or "imgtype":
+ *   ubi    - OpenWrt factory image, written to the "ubi" NAND partition
+ *   uimage - kernel/initramfs, booted from RAM
+ *   kwb    - U-Boot image: refused (see flash_uboot)
+ */
+recovery=echo "Web recovery: browse to http://${ipaddr}/ - Ctrl-C to stop"; while httpd ${loadaddr}; do run recovery_apply; done
+recovery_apply=if test "${img_type}" = ubi; then run flash_ubi; elif test "${img_type}" = uimage; then bootm ${loadaddr}; elif test "${img_type}" = kwb; then run flash_uboot; else echo "Unknown image, nothing written"; fi
+flash_ubi=echo "Writing OpenWrt to NAND..."; nand erase.part ubi && nand write ${loadaddr} ubi ${filesize_blk} && setenv upgrade_available 1 && setenv bootcount 0 && saveenv && echo "Done, rebooting" && reset
+/*
+ * The BootROM reads the u-boot partition with Marvell 4-bit Reed-Solomon ECC,
+ * which this U-Boot cannot compute: a plain "nand write" there would not boot.
+ * U-Boot updates are done with a pre-encoded image (.tools/kwrs.py) and
+ * "nand write.raw", see out/INSTALL-PLAN.md.
+ */
+flash_uboot=echo "U-Boot images are not written from here (needs Reed-Solomon ECC), nothing written"
+flash_tftp=tftpboot ${loadaddr} ${factory_file} && imgtype ${loadaddr} ${filesize} && run recovery_apply
+flash_usb=usb start && fatload usb 0:1 ${loadaddr} ${factory_file} && imgtype ${loadaddr} ${filesize} && run recovery_apply
+flash_http=wget ${loadaddr} ${http_url} && imgtype ${loadaddr} ${filesize} && run recovery_apply
+
+/*
+ * Full NAND backup to a FAT formatted USB stick (needs 140 MB free):
+ *   wireless-space-nand-raw.bin - every page + its 64 byte OOB, no ECC
+ *     applied (65536 x 2112 bytes): exact copy whatever ECC wrote it
+ *   wireless-space-nand.bin     - data only, read with ECC, bad blocks
+ *     as 0xff so offsets match
+ */
+backup_usb=usb start && nand read.raw ${loadaddr} 0 0x10000 && fatwrite usb 0:1 ${loadaddr} wireless-space-nand-raw.bin 0x8400000 && nandbackup ${loadaddr} && fatwrite usb 0:1 ${loadaddr} wireless-space-nand.bin 0x8000000 && echo "Backup written to USB: wireless-space-nand-raw.bin, wireless-space-nand.bin"
+
+/* Boot menu (serial console or netconsole); entry 0 runs after the timeout */
+bootmenu_delay=3
+bootmenu_0=Boot OpenWrt (NAND, then USB, then disk)=run boot_default
+bootmenu_1=Boot from USB stick (/boot/uImage)=run boot_usb
+bootmenu_2=Boot from internal disk (/boot/uImage)=run boot_disk
+bootmenu_3=Boot initramfs from TFTP server=run boot_tftp
+bootmenu_4=Boot initramfs from HTTP URL=run boot_http
+bootmenu_5=Network boot (DHCP + PXE)=run boot_pxe
+bootmenu_6=Web recovery (upload firmware with a browser)=run recovery
+bootmenu_7=Flash firmware from TFTP server=run flash_tftp
+bootmenu_8=Flash firmware from USB stick=run flash_usb
+bootmenu_9=Flash firmware from HTTP URL=run flash_http
+bootmenu_10=Backup whole NAND to USB stick=run backup_usb
+bootmenu_11=Restore default U-Boot settings=env default -a && saveenv && reset
