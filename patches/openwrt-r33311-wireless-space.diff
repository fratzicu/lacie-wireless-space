+lacie_eeprom_mac()
+{
+	local eeprom=/sys/bus/i2c/devices/0-0050/eeprom
+	local version
+
+	[ -e "$eeprom" ] || return
+	version=$(hexdump -n 2 -e '1/2 "%u"' "$eeprom" 2>/dev/null)
+	# be16 version stored, hexdump reads little-endian: 1..3 -> 256..768
+	case "$version" in
+	256|512|768) hexdump -s 2 -n 6 -e '5/1 "%02x:" 1/1 "%02x"' "$eeprom" ;;
+	esac
+}
