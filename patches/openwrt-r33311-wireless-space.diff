diff --git a/target/linux/kirkwood/patches-6.12/204-mv88e6xxx-run-without-ptp-clock.patch b/target/linux/kirkwood/patches-6.12/204-mv88e6xxx-run-without-ptp-clock.patch
new file mode 100644
index 0000000000..62455067c5
--- /dev/null
+++ b/target/linux/kirkwood/patches-6.12/204-mv88e6xxx-run-without-ptp-clock.patch
@@ -0,0 +1,43 @@
+From: LaCie Wireless Space port
+Subject: net: dsa: mv88e6xxx: run without PTP if the TAI clock period is 0
+
+The 88E6161 rev 2 on the LaCie Wireless Space reads 0 from the TAI clock
+period register. mv88e6xxx_ptp_setup() then returns -ENODEV and the whole
+switch probe fails without a message. Disable PTP for that chip instead.
+
+--- a/drivers/net/dsa/mv88e6xxx/chip.c	2026-10-25 21:31:59.238092327 +0200
++++ b/drivers/net/dsa/mv88e6xxx/chip.c	2026-10-25 21:31:59.267600535 +0200
+@@ -4148,12 +4148,29 @@
+ 	/* Setup PTP Hardware Clock and timestamping */
+ 	if (chip->info->ptp_support) {
+ 		err = mv88e6xxx_ptp_setup(chip);
+-		if (err)
+-			goto unlock;
++		if (err == -ENODEV) {
++			struct mv88e6xxx_info *info;
+ 
+-		err = mv88e6xxx_hwtstamp_setup(chip);
+-		if (err)
++			/* Some 88E6161 report a TAI clock period of 0: run
++			 * the switch without PTP rather than failing probe.
++			 */
++			info = devm_kmemdup(chip->dev, chip->info,
++					    sizeof(*info), GFP_KERNEL);
++			if (!info) {
++				err = -ENOMEM;
++				goto unlock;
++			}
++			info->ptp_support = false;
++			chip->info = info;
++			dev_warn(chip->dev,
++				 "no usable PTP clock, timestamping disabled\n");
++		} else if (err) {
+ 			goto unlock;
++		} else {
++			err = mv88e6xxx_hwtstamp_setup(chip);
++			if (err)
++				goto unlock;
++		}
+ 	}
+ 
+ 	err = mv88e6xxx_stats_setup(chip);
diff --git a/target/linux/kirkwood/patches-6.12/205-phylink-only-use-mac_select_pcs-when-it-returns-pcs.patch b/target/linux/kirkwood/patches-6.12/205-phylink-only-use-mac_select_pcs-when-it-returns-pcs.patch
new file mode 100644
index 0000000000..7e900fd2dd
--- /dev/null
+++ b/target/linux/kirkwood/patches-6.12/205-phylink-only-use-mac_select_pcs-when-it-returns-pcs.patch
@@ -0,0 +1,29 @@
+From: LaCie Wireless Space port
+Subject: net: phylink: only call mac_select_pcs when the MAC uses it
+
+The pending PCS-list patches (737-02) call mac_select_pcs() whenever the
+MAC has the hook. DSA always has it and returns ERR_PTR(-EOPNOTSUPP) for
+switches without a PCS, e.g. the 88E6161: every user port then fails
+validation ("validation of gmii ... failed: -EOPNOTSUPP"). Check
+using_mac_select_pcs again, as upstream phylink does.
+
+--- a/drivers/net/phy/phylink.c	2026-10-25 21:40:09.874324237 +0200
++++ b/drivers/net/phy/phylink.c	2026-10-25 21:40:09.897963112 +0200
+@@ -714,7 +714,7 @@
+ 	mutex_lock(&pl->state_mutex);
+ 
+ 	/* Get the PCS for this interface mode */
+-	if (pl->mac_ops->mac_select_pcs) {
++	if (pl->using_mac_select_pcs) {
+ 		pcs = pl->mac_ops->mac_select_pcs(pl->config, state->interface);
+ 		if (IS_ERR(pcs)) {
+ 			mutex_unlock(&pl->state_mutex);
+@@ -1149,7 +1149,7 @@
+ 
+ 	mutex_lock(&pl->state_mutex);
+ 
+-	if (pl->mac_ops->mac_select_pcs) {
++	if (pl->using_mac_select_pcs) {
+ 		pcs = pl->mac_ops->mac_select_pcs(pl->config,
+ 						  interface);
+ 		pcs_found = !!pcs;
