diff --git a/target/linux/kirkwood/base-files/etc/init.d/ws-led b/target/linux/kirkwood/base-files/etc/init.d/ws-led
new file mode 100755
index 0000000000..66095ee7d8
--- /dev/null
+++ b/target/linux/kirkwood/base-files/etc/init.d/ws-led
@@ -0,0 +1,27 @@
+#!/bin/sh /etc/rc.common
+
+START=99
+STOP=01
+USE_PROCD=1
+
+ws() {
+	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "lacie,wireless-space" ]
+}
+
+start_service() {
+	ws && /usr/sbin/ws-led ready
+}
+
+# LED entries changed in /etc/config/system (System > LED Configuration);
+# its own trigger, as ucitrack runs only one script per config change
+reload_service() {
+	start_service
+}
+
+service_triggers() {
+	procd_add_reload_trigger system
+}
+
+stop_service() {
+	ws && /usr/sbin/ws-led shutdown
+}
diff --git a/target/linux/kirkwood/base-files/etc/rc.wps/10-ws-led b/target/linux/kirkwood/base-files/etc/rc.wps/10-ws-led
new file mode 100755
index 0000000000..9db1481c24
--- /dev/null
+++ b/target/linux/kirkwood/base-files/etc/rc.wps/10-ws-led
@@ -0,0 +1,28 @@
+#!/bin/sh
+# LaCie Wireless Space: front light blue/green flickering while the WPS
+# push-button session that the next rc.wps script starts is running.
+# Always fails, so the real WPS scripts still run.
+
+[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "lacie,wireless-space" ] || exit 1
+[ "$ACTION" = "released" ] || exit 1
+[ "$SEEN" -lt 3 ] || exit 1
+
+(
+	/usr/sbin/ws-led wps
+	sleep 2
+	# up to the 120 s of a WPS session, plus margin
+	i=0
+	while [ $i -lt 65 ]; do
+		active=0
+		for obj in $(ubus -S list 'hostapd.*'); do
+			ubus -S call "$obj" wps_status 2>/dev/null |
+				grep -q '"pbc_status":"Active"' && active=1
+		done
+		[ $active = 1 ] || break
+		sleep 2
+		i=$((i + 1))
+	done
+	/usr/sbin/ws-led ready
+) </dev/null >/dev/null 2>&1 &
+
+exit 1
diff --git a/target/linux/kirkwood/base-files/etc/rc.wps/45-ws-wifi b/target/linux/kirkwood/base-files/etc/rc.wps/45-ws-wifi
new file mode 100755
index 0000000000..2824e8478d
--- /dev/null
+++ b/target/linux/kirkwood/base-files/etc/rc.wps/45-ws-wifi
@@ -0,0 +1,32 @@
+#!/bin/sh
+# LaCie Wireless Space: WPS button held 3 s or more switches Wi-Fi on/off,
+# as on the stock firmware (front light blue = on, green = off, set by
+# /etc/hotplug.d/net/50-ws-led). Saved, so it stays after a reboot.
+
+[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "lacie,wireless-space" ] || exit 1
+[ "$ACTION" = "released" ] || exit 1
+[ "$SEEN" -ge 3 ] || exit 1
+
+. /lib/functions.sh
+
+radios=
+on=0
+check_radio() {
+	local disabled
+	config_get_bool disabled "$1" disabled 0
+	radios="$radios $1"
+	[ "$disabled" = 0 ] && on=1
+}
+config_load wireless
+config_foreach check_radio wifi-device
+[ -n "$radios" ] || exit 1
+
+if [ "$on" = 1 ]; then new=1 state=off; else new=0 state=on; fi
+for r in $radios; do
+	uci set wireless.$r.disabled=$new
+done
+uci commit wireless
+logger -t ws-wifi "WPS button held ${SEEN} s: Wi-Fi $state"
+wifi reload
+
+exit 0
diff --git a/target/linux/kirkwood/base-files/lib/upgrade/platform.sh b/target/linux/kirkwood/base-files/lib/upgrade/platform.sh
index 9885bf7d31..25ff929d61 100644
--- a/target/linux/kirkwood/base-files/lib/upgrade/platform.sh
+++ b/target/linux/kirkwood/base-files/lib/upgrade/platform.sh
@@ -37,13 +37,35 @@ platform_do_upgrade() {
 	iptime,nas1)
 		default_do_upgrade "$1"
 		;;
+	lacie,internet-space)
+		# stock U-Boot loads the kernel raw from sda6, root is squashfs on
+		# sda1 with the overlay behind it (fstools rootdisk)
+		export EMMC_KERN_DEV=/dev/sda6
+		export EMMC_ROOT_DEV=/dev/sda1
+		emmc_do_upgrade "$1"
+		;;
 	linksys,e4200-v2|\
 	linksys,ea3500|\
 	linksys,ea4500)
 		platform_do_upgrade_linksys "$1"
 		;;
+	lacie,wireless-space)
+		# front light blue/green/red blinking, as the stock firmware
+		for led in red:status green:status blue:status; do
+			echo timer > /sys/class/leds/$led/trigger
+		done
+		nand_do_upgrade "$1"
+		;;
 	*)
 		nand_do_upgrade "$1"
 		;;
 	esac
 }
+
+platform_copy_config() {
+	case "$(board_name)" in
+	lacie,internet-space)
+		emmc_copy_config
+		;;
+	esac
+}
diff --git a/target/linux/kirkwood/base-files/usr/sbin/ws-fan b/target/linux/kirkwood/base-files/usr/sbin/ws-fan
new file mode 100755
index 0000000000..73d035ba3b
--- /dev/null
+++ b/target/linux/kirkwood/base-files/usr/sbin/ws-fan
@@ -0,0 +1,69 @@
+#!/bin/sh
+# LaCie Wireless Space: set the fan (gpio-fan) from the disk temperature
+# (drivetemp). The board has no other usable sensor. Without a disk or a
+# reading the fan stays at its lowest speed.
+#
+#   temp < 40 C: 1220 rpm   40-45: 1700   45-50: 3200   50-55: 4900   55+: 5400
+#
+# A lower speed is only taken once the disk is 2 C under its threshold.
+
+INTERVAL=30
+HYST=2
+
+hwmon_by_name() {
+	local h
+	for h in /sys/class/hwmon/hwmon*; do
+		[ "$(cat "$h/name" 2>/dev/null)" = "$1" ] && { echo "$h"; return 0; }
+	done
+	return 1
+}
+
+# disk temperature (C) -> fan level 0..4
+level() {
+	if [ "$1" -ge 55 ]; then echo 4
+	elif [ "$1" -ge 50 ]; then echo 3
+	elif [ "$1" -ge 45 ]; then echo 2
+	elif [ "$1" -ge 40 ]; then echo 1
+	else echo 0
+	fi
+}
+
+rpm() {
+	case "$1" in
+	0) echo 1220 ;; 1) echo 1700 ;; 2) echo 3200 ;; 3) echo 4900 ;; *) echo 5400 ;;
+	esac
+}
+
+cur=-1
+alarm=0
+while :; do
+	fan=$(hwmon_by_name gpio_fan)
+	if [ -n "$fan" ]; then
+		new=0
+		disk=$(hwmon_by_name drivetemp)
+		t=$(cat "$disk/temp1_input" 2>/dev/null)
+		if [ -n "$t" ]; then
+			t=$((t / 1000))
+			new=$(level "$t")
+			# going down: only when also lower with the hysteresis added
+			if [ "$cur" -gt "$new" ]; then
+				new=$(level $((t + HYST)))
+				[ "$new" -gt "$cur" ] && new=$cur
+			fi
+		fi
+		if [ "$new" != "$cur" ]; then
+			echo 1 > "$fan/pwm1_enable"
+			echo "$(rpm "$new")" > "$fan/fan1_target" &&
+				logger -t ws-fan "disk ${t:-?} C: fan $(rpm "$new") rpm"
+			cur=$new
+		fi
+		a=$(cat "$fan/fan1_alarm" 2>/dev/null)
+		if [ "$a" = 1 ] && [ "$alarm" = 0 ]; then
+			logger -p daemon.err -t ws-fan "fan stopped (fail signal)"
+		elif [ "$a" = 0 ] && [ "$alarm" = 1 ]; then
+			logger -t ws-fan "fan running again"
+		fi
+		alarm=${a:-0}
+	fi
+	sleep $INTERVAL
+done
diff --git a/target/linux/kirkwood/base-files/usr/sbin/ws-led b/target/linux/kirkwood/base-files/usr/sbin/ws-led
new file mode 100755
index 0000000000..b5cd788778
--- /dev/null
+++ b/target/linux/kirkwood/base-files/usr/sbin/ws-led
@@ -0,0 +1,108 @@
+#!/bin/sh
+# LaCie Wireless Space front light, as in the stock manual (1.8 Light Behavior):
+#
+#   ready     blue with Wi-Fi on, green with Wi-Fi off; the other colour
+#             flickers with disk access (blue+green, the LED has one colour
+#             per chip and the disk trigger only lights a LED)
+#   fault     red, no disk found
+#   shutdown  red
+#   upgrade   blue/green/red blinking
+#   touch     blue/green fast blinking while the touch button is held
+#             ("Sense cap has been pushed")
+#   hold      touch held 3 s: the colour Wi-Fi will get on release
+#             (green = it goes off, blue = it comes on)
+#   wps       blue/green blinking while a WPS push-button session runs
+#
+# Boot (blue fast blinking) and failsafe (red blinking) come from the
+# led-boot/led-failsafe aliases in the DTS through /etc/diag.sh.
+#
+# A colour that has its own LED entry in /etc/config/system (System > LED
+# Configuration in LuCI) is left to that entry, except for shutdown and
+# upgrade; deleting the entry gives it back to this scheme.
+
+L=/sys/class/leds
+
+case "$1" in
+shutdown|upgrade) USER_LEDS= ;;
+*) USER_LEDS=" $(uci -q show system | sed -n "s/^system\..*\.sysfs='\(.*\)'$/\1/p" | tr '\n' ' ')" ;;
+esac
+
+led() {	# led <name> <trigger> [brightness]
+	[ -d "$L/$1" ] || return 0
+	case "$USER_LEDS" in *" $1 "*) return 0 ;; esac
+	echo "$2" > "$L/$1/trigger"
+	[ -n "$3" ] && echo "$3" > "$L/$1/brightness"
+}
+
+disk_trigger() {	# libata trigger of the port that holds sda, e.g. ata2
+	readlink -f /sys/block/sda 2>/dev/null | grep -o '/ata[0-9][0-9]*/' | tr -d / | head -n 1
+}
+
+# Wi-Fi counts as on while a wireless interface exists (netifd removes
+# them when the radio or the last wifi-iface is disabled)
+wifi_up() {
+	local d
+	for d in /sys/class/net/*; do
+		[ -e "$d/phy80211" ] && return 0
+	done
+	return 1
+}
+
+case "$1" in
+ready)
+	led red:fault none 0
+	ata=$(disk_trigger)
+	if [ -z "$ata" ]; then
+		led blue:status none 0
+		led green:status none 0
+		led red:status none 1
+		exit 0
+	fi
+	led red:status none 0
+	if wifi_up; then
+		base=blue:status other=green:status
+	else
+		base=green:status other=blue:status
+	fi
+	led "$base" default-on
+	led "$other" "$ata"
+	;;
+fault|shutdown)
+	led blue:status none 0
+	led green:status none 0
+	led red:fault none 0
+	led red:status none 1
+	;;
+touch|wps)
+	led red:fault none 0
+	led red:status none 0
+	t=300
+	[ "$1" = touch ] && t=70
+	for l in blue:status green:status; do
+		case "$USER_LEDS" in *" $l "*) continue ;; esac
+		led $l timer
+		echo $t > $L/$l/delay_on
+		echo $t > $L/$l/delay_off
+	done
+	;;
+hold)
+	led red:status none 0
+	if wifi_up; then
+		led green:status default-on
+		led blue:status none 0
+	else
+		led blue:status default-on
+		led green:status none 0
+	fi
+	;;
+upgrade)
+	led red:fault none 0
+	for l in red:status green:status blue:status; do
+		led $l timer
+	done
+	;;
+*)
+	echo "usage: $0 ready|fault|shutdown|upgrade|touch|hold|wps" >&2
+	exit 1
+	;;
+esac
diff --git a/target/linux/kirkwood/config-6.12 b/target/linux/kirkwood/config-6.12
index 57e9bfdb13..087c74747c 100644
--- a/target/linux/kirkwood/config-6.12
+++ b/target/linux/kirkwood/config-6.12
@@ -125,6 +125,7 @@ CONFIG_GENERIC_STRNLEN_USER=y
 CONFIG_GLOB=y
 CONFIG_GPIOLIB_IRQCHIP=y
 CONFIG_GPIO_CDEV=y
